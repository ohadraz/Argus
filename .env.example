# Copy to `.env` and fill in the secrets at the top. Everything below them is
# commented out and shows the default `argus_core.config.Settings` already
# uses, so a copy of this file runs the demo stack as-is; uncomment a line only
# to override it. An uncommented empty value is not "use the default" - it sets
# the value to the empty string.
#
# What each setting means and why it is what it is: `argus_core/config.py`.
#
# `.env` is gitignored. Do not put a real credential anywhere else.

#==============================================================================
# Secrets - the only values that have to be filled in
#==============================================================================
ANTHROPIC_API_KEY=
# The credential that can change a flag. Locally, the token the Target
# Environment's compose file seeds into its own Unleash (INIT_ADMIN_API_TOKENS).
UNLEASH_ADMIN_TOKEN=
# Optional. Empty means no credential is sent rather than an invented one; the
# demo's Argo stand-in needs none.
#ARGOCD_AUTH_TOKEN=

#==============================================================================
# Postgres
#==============================================================================
#DATABASE_USER=argus
#DATABASE_PASSWORD=argus
#DATABASE_HOST=localhost
#DATABASE_PORT=5432

#==============================================================================
# Target Service and the MCP tiers
#==============================================================================
#TARGET_SERVICE_URL=http://localhost:8080
#READ_MCP_HOST=localhost
#READ_MCP_PORT=8090
#WRITE_MCP_HOST=localhost
#WRITE_MCP_PORT=8092

#==============================================================================
# Anthropic
#==============================================================================
# Empty means the real API. Set it to point the client at a stand-in.
#ANTHROPIC_BASE_URL=

#==============================================================================
# Payment provider (Stripe)
#==============================================================================
# What the shop took, for the postmortem's loss estimate. Empty means the
# source reports it could not answer, and the estimate is published as absent
# rather than as zero. Against the demo this is the token the Target Service's
# Stripe-shaped endpoint accepts; against a real account it is a secret and
# belongs in `.env`, never here.
#STRIPE_API_KEY=
# Empty means the real API. The demo points it at the shop's own endpoint.
#STRIPE_BASE_URL=

#==============================================================================
# On-call provider (PagerDuty)
#==============================================================================
# Who responded to the incident and when, for the postmortem's engineer
# minutes. Empty means the source reports it could not answer, and the minutes
# are published as absent rather than as zero. Against the demo this is the
# token the Target Service's PagerDuty-shaped endpoints accept; against a real
# account it is a secret and belongs in `.env`, never here.
#PAGERDUTY_API_KEY=
# Empty means the real API. The demo points it at the Target Service's TLS
# port - the SDK refuses a base URL that is not https.
#PAGERDUTY_BASE_URL=
# Whether that provider's certificate is checked. Only ever false against the
# demo, whose certificate is self-signed and minted at startup.
#PAGERDUTY_VERIFY_TLS=true

#==============================================================================
# Exchange rates (Frankfurter)
#==============================================================================
# The European Central Bank's daily reference rates. No key, no account. The
# default reaches the real service; point it elsewhere to use a stand-in.
#EXCHANGE_RATE_BASE_URL=https://api.frankfurter.dev
# What a postmortem states its loss estimate in, and the base every rate is
# quoted against.
#REPORTING_CURRENCY=usd

#==============================================================================
# Feature-flag provider (Unleash)
#==============================================================================
#UNLEASH_BASE_URL=http://localhost:4242
#UNLEASH_FRONTEND_TOKEN=default:production.argus-demo-frontend-token
#UNLEASH_PROJECT=default
#UNLEASH_ENVIRONMENT=production
#UNLEASH_ACTOR=Argus

#==============================================================================
# Change source (Argo CD)
#==============================================================================
# The path is a template; one carrying no placeholder is used as written.
#ARGOCD_BASE_URL=http://localhost:8080
#ARGOCD_APPLICATION_PATH=/argocd/{application}

#==============================================================================
# Retrieval windows
#==============================================================================
#LOG_INITIAL_LOOKBACK_MINUTES=30
#LOG_INITIAL_LOOKAHEAD_MINUTES=10
#LOG_MAX_WINDOW_MINUTES=180
#METRICS_WINDOW_MINUTES=360
#CHANGE_LOOKBACK_MINUTES=1440

#==============================================================================
# Investigation
#==============================================================================
#MITIGATE_THRESHOLD=0.75
#INVESTIGATION_MAX_TOOL_CALLS=12
#INVESTIGATION_MAX_TOKENS=150000
#INVESTIGATION_MAX_SECONDS=300
#INVESTIGATION_MAX_ROUNDS=3
#INVESTIGATION_MAX_CANDIDATES=4
#ANOMALY_DEVIATIONS_FROM_BASELINE=3.0
#ANOMALY_PERSISTENCE_MINUTES=2

#==============================================================================
# Mitigation
#==============================================================================
#FLAG_CHANGE_LOOKBACK_MINUTES=60
#MITIGATION_VERIFICATION_TIMEOUT_SECONDS=180
