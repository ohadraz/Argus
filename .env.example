# Copy to `.env` and fill in. Every variable below maps to a field on
# `argus_core.config.Settings`; the values shown are that field's default, so
# an empty `.env` runs the same as no `.env` at all.
#
# `.env` itself is gitignored. Do not put a real key anywhere else.

#==============================================================================
# Secrets - the only values here that actually have to be filled in
#==============================================================================
# Required. The Investigator will not run without it (spec §14 puts this in
# Vault eventually; it is an environment variable until Vault exists).
ANTHROPIC_API_KEY=
# Optional. A real Argo CD server issues these (`POST /api/v1/session`, or
# `argocd account generate-token`); the demo Target Service standing in for one
# needs none, and an empty value means no credential is sent rather than an
# invented one.
ARGOCD_AUTH_TOKEN=
# The credential that can change a flag. Locally it is the token the Target 
# Environment's compose file seeds into its own Unleash 
# (`INIT_ADMIN_API_TOKENS`); against a real provider it is a secret and belongs
# in `.env`, never here.
UNLEASH_ADMIN_TOKEN=

#==============================================================================
# Postgres
#==============================================================================
DATABASE_USER=argus
DATABASE_PASSWORD=argus
DATABASE_HOST=localhost
DATABASE_PORT=5432

#==============================================================================
# Target Service and the read-only MCP server
#==============================================================================
TARGET_SERVICE_URL=http://localhost:8080
READ_MCP_HOST=localhost
READ_MCP_PORT=8090
# The write tier runs as its own process (spec §12.1) - the split is what makes
# "read-only" a property of a running process rather than a convention.
WRITE_MCP_HOST=localhost
WRITE_MCP_PORT=8092

#==============================================================================
# Retrieval windows (spec §16)
#==============================================================================
# How far before the onset the first log window reaches. Widening moves this
# back; the window's end stays at the alert.
LOG_INITIAL_LOOKBACK_MINUTES=30
# A floor on how far past the onset a window reaches, for the case where the
# alert fired almost immediately. The alert time is what normally ends it.
LOG_INITIAL_LOOKAHEAD_MINUTES=10
# Ceiling on any log window, and the last step of the widening schedule.
LOG_MAX_WINDOW_MINUTES=180
# One fixed, wide span - metrics are four numbers a minute, and a narrow
# metrics window hides the onset it exists to find. Must exceed the log
# ceiling.
METRICS_WINDOW_MINUTES=360
# How far back to look for changes - deploys, and flag flips once that source
# exists. Far wider than the log ceiling, which it must exceed: a cause can
# precede its symptoms by an unbounded lag, and changes are sparse enough that
# a day of them costs almost nothing.
CHANGE_LOOKBACK_MINUTES=1440

#==============================================================================
# Feature-flag provider - read side (spec §12.1)
#==============================================================================
# Points at the Unleash the Target Environment's compose file brings up. The
# frontend token can evaluate flags and cannot change one: that is what makes
# `argus-read-mcp` incapable of changing state rather than merely disinclined.
# The admin token lives with `argus-write-mcp` and is not read here.
UNLEASH_BASE_URL=http://localhost:4242
UNLEASH_FRONTEND_TOKEN=default:production.argus-demo-frontend-token
# Which project and environment a flag change addresses. The read side needs
# neither - its credential is already scoped to one environment - but the admin
# API names both in its path.
UNLEASH_PROJECT=default
UNLEASH_ENVIRONMENT=production

#==============================================================================
# Change source - Argo CD (spec §16)
#==============================================================================
# Points at the demo Target Service's Argo stand-in by default. Against a real
# server this is its base URL and `/api/v1/applications/{application}`; the
# path is a template, and one carrying no placeholder is used as written.
ARGOCD_BASE_URL=http://localhost:8080
ARGOCD_APPLICATION_PATH=/argocd/{application}

#==============================================================================
# Investigation (spec §9, §10)
#==============================================================================
# Confidence at or above which the Orchestrator routes to mitigation.
MITIGATE_THRESHOLD=0.75
# Re-reads allowed before the loop gives up and escalates. At least 2.
INVESTIGATION_MAX_ITERATIONS=3
# How far a minute must sit from the service's own calm baseline to count as
# the incident starting - measured in the baseline's own spread, so the same
# number works whatever the service's normal error rate is.
ANOMALY_DEVIATIONS_FROM_BASELINE=3.0
# How many consecutive minutes must stay departed before the first of them is
# the onset. An incident holds; a lone departed minute is sampling noise that
# had already recovered by the next one.
ANOMALY_PERSISTENCE_MINUTES=2

#==============================================================================
# Mitigation (spec §7.3, §13)
#==============================================================================
# How far back Mitigation looks for the flag change an incident is about. Much
# shorter than CHANGE_LOOKBACK_MINUTES: that asks how far back a cause may
# plausibly lie for an investigation, this asks what somebody just changed.
# Widen it and "two flags changed, so I cannot tell which" becomes the norm.
FLAG_CHANGE_LOOKBACK_MINUTES=60
# How long to wait for the service to answer an action before calling the
# hypothesis refuted. Expiry is a verdict, not an error - the action was taken
# and did not visibly help in the time allowed.
MITIGATION_VERIFICATION_TIMEOUT_SECONDS=180
