# Copy to `.env` and fill in the secrets at the top. Everything below them is
# commented out and shows the default `argus_core.config.Settings` already
# uses, so a copy of this file runs the demo stack as-is; uncomment a line only
# to override it. An uncommented empty value is not "use the default" - it sets
# the value to the empty string.
#
# What each setting means and why it is what it is: `argus_core/config.py`.
#
# `.env` is gitignored. Do not put a real credential anywhere else.

#==============================================================================
# Secrets - the only values that have to be filled in
#==============================================================================
ANTHROPIC_API_KEY=
# The credential that can change a flag. Locally, the token the Target
# Environment's compose file seeds into its own Unleash (INIT_ADMIN_API_TOKENS).
# In the Target Demo Application, it is the following:
UNLEASH_ADMIN_TOKEN=*:*.argus-agent-token
# Optional. Empty means no credential is sent rather than an invented one; the
# demo's Argo stand-in needs none.
#ARGOCD_AUTH_TOKEN=
# The credential Code-Fix pushes a branch and opens a draft pull request with,
# against the Target Service's repository below and nothing else - "Argus cannot
# touch its own codebase" is a property of what this token reaches (§15.1). It
# can never merge what it opens (§13). A fine-grained PAT scoped to that one
# repository, with Contents: read and write, and Pull requests: read and write.
GITHUB_TOKEN=
# The credential the read tier reads that repository's source under. Read-only
# on purpose: `argus-read-mcp` must stay incapable of mutation, so this is a
# fine-grained PAT with Contents: read and nothing further. Empty reads a public
# repository unauthenticated, at 60 requests an hour - enough for a demo, not
# for a benchmark run.
#GITHUB_READ_TOKEN=
# Which directories of that repository hold the service itself, comma separated.
# Empty is the whole repository, which is right whenever the repository is
# nothing but the service. The demo's is not: it ships the shop beside the rig
# that stages incidents against it, and Code-Fix reading the rig is reading how
# its own incidents are generated rather than the code that caused one.
GITHUB_SOURCE_PATHS=src/io_shop,tests/io_shop
# The secret GitHub signs its push deliveries with, and the same string set on
# the webhook in that repository's settings. Empty accepts nothing rather than
# everything - with no secret configured no signature can match - so the index
# is then brought up to date by the catch-up loop's own pass instead of being
# told. A real value belongs in `.env`, never here.
#GITHUB_WEBHOOK_SECRET=

#==============================================================================
# Postgres
#==============================================================================
#DATABASE_USER=argus
#DATABASE_PASSWORD=argus
#DATABASE_HOST=localhost
#DATABASE_PORT=5432

#==============================================================================
# Target Service and the MCP tiers
#==============================================================================
#TARGET_SERVICE_URL=http://localhost:8080
#READ_MCP_HOST=localhost
#READ_MCP_PORT=8090
#WRITE_MCP_HOST=localhost
#WRITE_MCP_PORT=8092

#==============================================================================
# Anthropic
#==============================================================================
# Empty means the real API. Set it to point the client at a stand-in.
#ANTHROPIC_BASE_URL=
# Which model answers each agent, and how hard it is asked to think. Per agent
# because the work differs: the postmortem writes prose with every figure
# already measured, the investigator decides which evidence would settle the
# question, and Code-Fix writes whole files. Effort is one of low, medium,
# high, xhigh, max. The commented values restate the code defaults; an
# uncommented line is a deployment asking for something else.
# The investigator answers on Sonnet, measured over 500 investigations of the
# six pinned eval cases, 50 per arm. On the only case any arm gets wrong - the
# deploy that explains nothing - Sonnet at high scored 41 of 50 against Opus at
# high's 38, and sat beside Opus at medium's 27 of 30. It did that for 55% less:
# Sonnet's four rates are 40% of Opus's and the token counts came out level.
#INVESTIGATION_MODEL=claude-sonnet-5
# Effort stays high, and medium is the thing that was tried and rejected: it
# held every case on both models, and on Opus - where its spend was measured,
# twice - it billed 11% to 13% more output tokens than high did. Lower effort
# buys fewer thinking tokens and spends them on a longer answer, so there is
# nothing to trade here; the saving came from the model instead.
#INVESTIGATION_EFFORT=high
#CODEFIX_MODEL=claude-opus-5
#CODEFIX_EFFORT=high
#POSTMORTEM_MODEL=claude-opus-5
#POSTMORTEM_EFFORT=high
# How much room Code-Fix gets to write a fix in. Alone among the agents it
# answers with whole files, and the largest in the Target Service is 21,484
# tokens - so the 16,000 the others are happy with makes a whole class of
# fix impossible rather than merely tight. Past 21,333 the answer has to be
# streamed, which is the only way the SDK will carry one that large. A cap
# is not a reservation, so asking for the model's whole ceiling costs
# nothing on the fixes that turn out to be small.
#CODEFIX_MAX_OUTPUT_TOKENS=128000
# What one attempt at a fix may spend. Three bounds because they fail
# differently and none implies the others - this is the agent a call count
# alone cannot bound, since it reads whole files and carries every one it
# has read for the rest of the run. Calls rather than turns: a model may
# ask for several files at once.
#CODEFIX_MAX_TOOL_CALLS=40
#CODEFIX_MAX_TOKENS=870000
#CODEFIX_MAX_SECONDS=1100

#==============================================================================
# Slack
#==============================================================================
# The bot Argus posts as. Empty means it says nothing rather than guessing at
# a workspace. Against a real workspace this is a secret and belongs in `.env`,
# never here - and in CI it is the `SLACK_BOT_TOKEN` repository secret, read by
# the nightly's Slack contract and by no push-triggered job.
#SLACK_BOT_TOKEN=
# Empty means the real workspace. The suites point it at the Slack double,
# which is the only thing that selects the double.
#SLACK_BASE_URL=
# Where an incident is reported, and where its postmortem is delivered. Two
# channels because they have two audiences: whoever is on now, and whoever
# reads it afterwards.
#SLACK_WAR_ROOM_CHANNEL=
#SLACK_POSTMORTEM_CHANNEL=
# How long the relay waits after finding the log unchanged. The delay between
# something happening and a person hearing about it, and paid only where there
# is nothing to say - a pass that delivered anything looks again at once.
#SLACK_RELAY_POLL_SECONDS=2.0
# Where Argus answers, as somebody outside it reaches it - what a message in a
# channel links back to. Configured rather than observed: the relay serves no
# requests to learn a host from. Empty means messages carry no link.
#ARGUS_BASE_URL=http://localhost:8000

#==============================================================================
# Payment provider (Stripe)
#==============================================================================
# What the shop took, for the postmortem's loss estimate. Empty means the
# source reports it could not answer, and the estimate is published as absent
# rather than as zero. Against the demo this is the token the Target Service's
# Stripe-shaped endpoint accepts; against a real account it is a secret and
# belongs in `.env`, never here.
# Uncommented, because there is no real Stripe account to fall back to: the
# code's empty default means the real API, and with no credential for it the
# postmortem publishes the loss as absent. A fixture token the shop accepts
# from anybody is what turns that into a figure.
STRIPE_API_KEY=sk_test_the_shop_accepts_anything
# Empty means the real API. Pointed here at the shop's own endpoint, which is
# the only Stripe this project has.
STRIPE_BASE_URL=http://localhost:8080/stripe

#==============================================================================
# On-call provider (PagerDuty)
#==============================================================================
# Who responded to the incident and when, for the postmortem's engineer
# minutes. Empty means the source reports it could not answer, and the minutes
# are published as absent rather than as zero. Against the demo this is the
# token the Target Service's PagerDuty-shaped endpoints accept; against a real
# account it is a secret and belongs in `.env`, never here.
# Uncommented for the reason the Stripe one is: there is no real account, and
# an empty credential publishes the engineer minutes as absent rather than
# reading them from the stand-in that does answer.
PAGERDUTY_API_KEY=the-shop-accepts-anything
# Empty means the real API. Pointed at the Target Service's TLS port rather
# than its plain one, because the SDK refuses a base URL that is not https.
PAGERDUTY_BASE_URL=https://localhost:8443/pagerduty
# Whether that provider's certificate is checked. False here, and only here:
# the line above is a listener on this machine whose certificate is self-signed
# and minted at startup, so there is nothing for a check to trust.
PAGERDUTY_VERIFY_TLS=false

#==============================================================================
# Pay bands (BambooHR)
#==============================================================================
# What a job title is worth, so the minutes people spent on an incident can be
# priced. Empty means the source reports it could not answer, and the cost is
# published as absent rather than as zero.
#
# This credential reads pay grades and bands and nothing else. Nothing here
# reads anybody's compensation, and a credential that could is a wider grant
# than Argus asks for.
# Uncommented for the reason the two above are. The URL below is already the
# code's default and is restated only so the pair reads as one decision: the
# endpoint that answers and a credential to reach it with.
HR_API_KEY=the-shop-accepts-anything
# Where those bands are read from. The Target Environment's HR-shaped endpoint;
# a real deployment points it at its own account.
HR_BASE_URL=http://localhost:8080/bamboohr
#HR_TIMEOUT_SECONDS=10.0

# How many working hours a year an annual band is quoted against - what turns a
# salary into what a minute of it costs. 2080 is the standard full-time year:
# 40 hours a week, 52 weeks. Whatever it is set to is stated on the postmortem.
#WORKING_HOURS_A_YEAR=2080.0

#==============================================================================
# Exchange rates (Frankfurter)
#==============================================================================
# The European Central Bank's daily reference rates. No key, no account. The
# default reaches the real service; the demo points it at the Target Service's
# own Frankfurter-shaped endpoint, so a run does not depend on the internet.
#EXCHANGE_RATE_BASE_URL=https://api.frankfurter.dev
# What a postmortem states its loss estimate in, and the base every rate is
# quoted against.
#REPORTING_CURRENCY=usd

#==============================================================================
# Feature-flag provider (Unleash)
#==============================================================================
#UNLEASH_BASE_URL=http://localhost:4242
#UNLEASH_FRONTEND_TOKEN=default:production.argus-demo-frontend-token
#UNLEASH_PROJECT=default
#UNLEASH_ENVIRONMENT=production
#UNLEASH_ACTOR=Argus

#==============================================================================
# The Target Service's repository (GitHub)
#==============================================================================
# The one repository Argus may propose a change to, as `owner/name` - which is
# how the API addresses one, and why it is a single setting rather than two a
# deployment could assemble into a different repository. Left empty, Code-Fix
# fails against the API rather than proposing anywhere unintended - there is no
# repository it could fall back to.
GITHUB_REPOSITORY=
#GITHUB_API_URL=https://api.github.com

#==============================================================================
# The repository index (Qdrant)
#==============================================================================
# Where that repository's source is kept as something searchable by meaning, so
# Code-Fix can find the code a fault is described by rather than the code a
# fault is named in. Built ahead of time by the catch-up loop, never on an
# incident's path. The default is the compose file's store; a deployment names
# the service.
#QDRANT_URL=http://localhost:6333
# One collection per deployment, named for what it holds. A deployment pointed
# at a different repository is a different index.
#CODE_INDEX_COLLECTION=target_service_source
# Which model turns a passage of code - and a question about it - into the
# vector whose closeness is the whole of what "found by meaning" means. It runs
# in this process: no key, no network, no bill.
#
# Changing it is a re-index rather than a restart. The width of the collection
# and the meaning of every stored vector both follow from the model, so points
# embedded by the old one answer nothing sensible to a query embedded by the
# new. Named here so §21's benchmark can ask whether a bigger or code-trained
# model retrieves better - which is the one question a fixed model cannot be
# asked.
#CODE_INDEX_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# How a file whose structure nothing here understands is cut into passages, in
# lines, and how many lines of each window the next one repeats. The overlap is
# what keeps a fault straddling a cut whole inside one passage, and it must be
# smaller than the window or a window never advances.
#
# The fallback only: Python is cut at its own definitions, because a function is
# as long as it is and one truncated to fit a window stops mid-statement.
#CODE_INDEX_MAX_LINES=60
#CODE_INDEX_CHUNK_OVERLAP=10
# How often the catch-up loop looks for work, in seconds.
#CODE_INDEX_INTERVAL_SECONDS=60

# --- Long-term memory: what earlier incidents were done about (spec 11.2) ---
# The same Qdrant as the index above, in a collection of its own. Two corpora
# with nothing to do with each other, and one server.
#INCIDENT_MEMORY_COLLECTION=incidents_remembered
# Whether an incident is remembered at all, and whether what is remembered is
# consulted when the next incident's candidates are ordered.
#
# Off is a real configuration rather than a way of switching off something
# broken: the 21 benchmark's whole question is what memory is worth, and two
# runs differing in exactly one thing are how that is asked.
#INCIDENT_MEMORY_ENABLED=true
# Which model turns an incident's description into the vector a later incident
# is compared against. A different corpus from the index's, so a setting of its
# own - and changing it, like changing the index's, leaves everything already
# stored answering a new query nonsensically.
#INCIDENT_MEMORY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# How many past incidents inform one ordering decision, and how unlike this one
# a record may be and still be consulted.
#
# Both are starting guesses. The floor is the one that matters: a
# nearest-neighbour search always answers, so without it a corpus holding one
# unrelated incident hands it back as the nearest thing it has, and a candidate
# is demoted on the strength of it.
#INCIDENT_MEMORY_RECALL_LIMIT=5
#INCIDENT_MEMORY_SIMILARITY_FLOOR=0.5
# Which ways of finding code this deployment has: `grep`, `meaning` or `both`.
# It switches the whole mechanism, not just what Code-Fix is offered: `grep`
# builds no index, opens no vector store and registers no retrieval tool, so
# a deployment that will not use RAG does none of that work.
#
# `both` is the production setting - the model is handed both tools and picks
# per question, which is the choice it is best placed to make. The single
# channels exist for §21's benchmark, where comparing two retrievers means
# running each alone over the same incidents.
#CODE_SEARCH=both

#==============================================================================
# Change source (Argo CD)
#==============================================================================
# The path is a template; one carrying no placeholder is used as written.
#ARGOCD_BASE_URL=http://localhost:8080
#ARGOCD_APPLICATION_PATH=/argocd/{application}
# Where a restart is asked for. A real Argo CD's is
# `/api/v1/applications/{application}/resource/actions/v2`.
#ARGOCD_RESTART_ACTION_PATH=/argocd/{application}/resource/actions/v2
# What the platform calls the thing that gets restarted, which is not what the
# alert calls the service. The demo's stand-in ignores both - it has one service
# and no namespaces.
#RESTART_NAMESPACE=production
#RESTART_RESOURCE_NAME=io-shop
# Where a rollback is asked for, and where the sync policy is written. Two
# routes rather than one, because a rollback is three requests: the application
# is read, reconciliation is suspended - a real server refuses a rollback while
# it is on - and only then is the rollback asked for.
#ARGOCD_ROLLBACK_PATH=/argocd/{application}/rollback
#ARGOCD_SPEC_PATH=/argocd/{application}/spec

#==============================================================================
# Retrieval windows
#==============================================================================
#LOG_INITIAL_LOOKBACK_MINUTES=30
#LOG_INITIAL_LOOKAHEAD_MINUTES=10
#LOG_MAX_WINDOW_MINUTES=180
#METRICS_WINDOW_MINUTES=360
#CHANGE_LOOKBACK_MINUTES=1440

#==============================================================================
# Investigation
#==============================================================================
#INVESTIGATION_MAX_TOOL_CALLS=12
#INVESTIGATION_MAX_TOKENS=200000
#INVESTIGATION_MAX_SECONDS=300
#INVESTIGATION_MAX_ROUNDS=3
#INVESTIGATION_MAX_CANDIDATES=4
#ANOMALY_DEVIATIONS_FROM_BASELINE=3.0
#ANOMALY_PERSISTENCE_MINUTES=2
# How far a minute has to have fallen back, as a fraction of the rise the
# incident made, before a mitigation counts as having worked.
#RECOVERY_FRACTION_OF_THE_RISE=0.8

#==============================================================================
# Mitigation
#==============================================================================
#FLAG_CHANGE_LOOKBACK_MINUTES=60
#MITIGATION_VERIFICATION_TIMEOUT_SECONDS=180

#==============================================================================
# The worker that walks incidents
#==============================================================================
# How long it waits before asking an empty queue again.
#RUN_POLL_INTERVAL_SECONDS=2
# How long a claim on a run holds before another worker may take it back. Kept
# comfortably longer than the verification wait above, which is the longest a
# walk stands still for.
#RUN_LEASE_SECONDS=720
