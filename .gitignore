#==============================================================================
# General Rules
#==============================================================================
# Ignore hidden files
.*


#==============================================================================
# GitIgnore Configuration (Whitelist)
#==============================================================================
# Allow the .gitignore file
!.gitignore
# And the .gitattributes file, which is what makes line endings LF for everyone
# rather than for whoever happens to have configured it that way.
!.gitattributes


#==============================================================================
# Claude Configuration (Whitelist)
#==============================================================================
# Allow the .claude directory, but only track shared project configs
!.claude/
!.claude/settings.json
!.claude/commands/
!.claude/agents/
!.claude/skills/
# ... but ignore the local settings file, and the handover file
.claude/settings.local.json
.claude/HANDOVER.md
# ... and the hooks only the local settings wire up, which would otherwise be
# committed machinery nothing in this repository runs
.claude/hooks/check_handoff_edit_format.py


#==============================================================================
# Environment (Whitelist)
#==============================================================================
# The real `.env` stays ignored by the blanket rule above - it holds secrets.
# Its template is tracked, so a fresh clone can see which variables the
# process needs without being told.
!.env.example


#==============================================================================
# GitHub Configuration (Whitelist)
#==============================================================================
# Allow the .github directory, but only track shared project configs
!.github/
!.github/workflows/


#==============================================================================
# Python Artifacts
#==============================================================================
__pycache__/
*.pyc
build/
dist/
*.egg-info/


#==============================================================================
# pre-commit framework (Whitelist)
# run a set of checks automatically, right before git commit actually creates
# the commit, and block the commit if any check fails
#==============================================================================
# Allow the .pre-commit-config.yaml file
!.pre-commit-config.yaml


#==============================================================================
# Test timings (Whitelist)
#==============================================================================
# Written by `pytest-split --store-durations`, and tracked on purpose: CI reads
# it to decide which e2e case goes to which runner, so a measurement nobody
# committed leaves the shares split by test count instead of by time.
!.test_durations
